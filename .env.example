# Copy to .env and fill in values. Do not commit .env.

# Provider: qwen | ollama | openai (CLI --provider overrides this)
MEMIMPACT_PROVIDER=qwen

# DashScope / Qwen
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-hongkong
# QWEN_MODEL=qwen3.8-flash

# Optional: full OpenAI-compatible endpoint instead of workspace_id + region
# DASHSCOPE_BASE_URL=

# Ollama (set MEMIMPACT_PROVIDER=ollama for local testing)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=qwen3.8:27b

# OpenAI (set MEMIMPACT_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-6-luna
